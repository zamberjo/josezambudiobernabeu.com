{
	"name": "josezambudiobernabeu.com",
	"version": "0.0.1",
	"private": true,
	"packageManager": "pnpm@11.3.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"preview": "pnpm --filter web preview",
		"check": "pnpm --recursive --if-present check",
		"lint": "prettier --ignore-path .gitignore --ignore-path .prettierignore --check . && eslint .",
		"format": "prettier --ignore-path .gitignore --ignore-path .prettierignore --write .",
		"test": "pnpm --filter web test",
		"test:unit": "vitest run",
		"test:db": "sh scripts/with-local-supabase.sh vitest run packages/adapters/src/supabase",
		"build:local": "sh scripts/with-local-supabase.sh env CONTENT_SOURCE=supabase pnpm build",
		"db:start": "supabase start",
		"db:reset": "supabase db reset",
		"db:types": "pnpm --filter @jzb/adapters db:types",
		"content:seed": "pnpm --filter @jzb/adapters content:seed",
		"content:export": "pnpm --filter @jzb/adapters content:export",
		"backoffice": "pnpm --filter backoffice dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.0",
		"@types/node": "^24.13.6",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.0.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	}
}
