# Where the build reads content from: `json` (content/portfolio.json, the
# default) or `supabase`.
CONTENT_SOURCE=json

# Needed only with CONTENT_SOURCE=supabase. The publishable (or legacy anon)
# key: it can only read the `api` views.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=
