# The backoffice signs in with Supabase Auth and writes with the editor's
# session, so row level security guards every change. It never needs the
# secret/service-role key.
#
# Local stack (`supabase start`): `supabase status` prints both values.
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=

# For the Publish button: a fine-grained token on the site repository with
# "Contents: read and write", which is what repository_dispatch needs.
GITHUB_TOKEN=
GITHUB_REPOSITORY=zamberjo/josezambudiobernabeu.com
