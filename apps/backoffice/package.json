{
	"name": "backoffice",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "Local-only content editor for the portfolio. Never deployed.",
	"scripts": {
		"dev": "vite dev --port 5174 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5174",
